      "lyric-timing-value": { "id": "lyric-timing-value", "text": "0.0s|+0.1s|-0.1s" },
      "lyric-timing-song": { "id": "lyric-timing-song", "text": "当前歌曲" },
      "lyric-timing-actions": {
        "class": "lyric-timing-actions",
        "childOrder": ["offset-minus", "offset-reset", "offset-plus"],
        "grid": "repeat(3, minmax(0,1fr))"
