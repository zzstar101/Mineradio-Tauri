        "zIndex": 7,
        "width": "min(420px, calc(100vw - 32px))"
      },
      "mini-queue-head": {
        "id": null,
        "class": "mini-queue-head",
        "childOrder": ["mini-queue-head-copy", "mini-queue-close"]
      },
      "mini-queue-head-copy": {
        "childOrder": ["mini-queue-title", "mini-queue-count"]
      },
