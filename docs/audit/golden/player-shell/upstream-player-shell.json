      "fade-row-out": { "class": "fade-control-row", "childOrder": ["fade-out-label", "fade-out-slider", "fade-out-value"], "label": "淡出" },
      "fade-out-slider": { "id": "fade-out-slider", "type": "range", "min": 0, "max": 3, "step": 0.05, "aria-label": "音乐淡出秒数" },
      "fade-out-value": { "id": "fade-out-value", "text": "0.40s" },
