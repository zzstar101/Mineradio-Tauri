  "interactions": {
    "reorder": "mini-queue long-press ~520ms then drag reorder within list; queue panel shares reorder state",
    "closeMiniQueue": "explicit × button; outside pointerdown closes",
    "lyricOffset": {
      "model": "per-track offset map keyed by track identity (provider+id / local key)",
      "steps": [-0.1, 0, 0.1],
      "range": [-5, 5],
      "apply": "lyric view clock only (never mutates payload); toast 歌词提前/延后/已重置",
      "persistKey": "mineradio-lyric-timing-offsets-v1",
      "limit": 500
    },
    "autoHide": {
      "toggle": "controls-hide-btn (active = auto-hide on)",
      "idle": "mouse idle / leave → controls condensed",
      "hover": "hovering shell keeps visible",
      "popoverOpen": "popover remains usable",
      "immersiveForcesOn": true
    },
    "immersive": {
      "enter": "save shelf/lyrics/autoHide/bottom state; add body.immersive-mode; force particle lyrics; force auto-hide on; close all popovers/modals; reveal then auto-hide after ~980ms",
      "exit": "restore saved state; close mini queue; toast 已退出全沉浸式",
      "fullscreen": "independent; fullscreen button remains"
    },
    "fullscreen": {
      "buttonTitle": "全屏 (F)",
      "behavior": "Tauri window fullscreen command; shell hidden surfaces unchanged otherwise"
    },
    "detail": {
      "cover": "album detail",
      "title": "song detail",
      "artist": "artist detail",
      "capabilityGate": "provider without detail capability must gate affordance; never call missing route"
    },
    "like": "capability-gated by provider (netease/soda like; netease/qq collect); supported→render/enable, unsupported→hidden/disabled consistent with upstream",
    "quality": "metadata chip; entitlement disabled state + current label; switching reloads URL"
  }
